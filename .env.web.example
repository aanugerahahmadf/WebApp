# Web Platform Environment Configuration
# 
# This file contains environment variables specific to the web platform
# (accessed via php artisan serve:web or a standard web server).
# 
# These values override the base .env file when running in web mode.
# Copy this file to .env.web and customize for your web deployment.
#
# ── Multi-Port Development Strategy ──────────────────────────────────────────
# When running multiple platform modes simultaneously, each uses a distinct port:
#   Web    (php artisan serve:web)    → port 8000  (this file)
#   Mobile (php artisan serve:mobile) → port 8001  (see .env.mobile.example)
#   Desktop(php artisan serve:desktop)→ port 8002  (see .env.desktop.example)
#
# Start web mode:  php artisan serve:web --port=8000
# ─────────────────────────────────────────────────────────────────────────────

# Application URL for web platform
# Use the actual domain or localhost for development
APP_URL=http://localhost:8000

# Session driver for web platform
# Cookie-based sessions work well for web browsers
SESSION_DRIVER=cookie

# Session lifetime (in minutes)
# Web sessions can be longer-lived
SESSION_LIFETIME=120

# Cache driver for web platform
# File cache is sufficient for single-server web deployments
# Use redis or memcached for multi-server setups
CACHE_DRIVER=file

# Queue connection for web platform
# Sync is fine for development, use redis/database for production
QUEUE_CONNECTION=sync

# Broadcasting driver for web platform
# Use pusher or redis for real-time features
BROADCAST_DRIVER=log

# Filesystem disk for web uploads
# Public disk makes files accessible via web server
FILESYSTEM_DISK=public

# VITE configuration for web platform
VITE_PLATFORM=web

# Web-specific feature flags
WEB_ENABLE_PWA=false
WEB_ENABLE_SERVICE_WORKER=false

# CORS configuration for web API access
# Adjust based on your frontend domain
# Using port 8000 (dedicated web platform port)
SANCTUM_STATEFUL_DOMAINS=localhost:8000,127.0.0.1:8000

# Web platform analytics
# Add your web analytics tracking IDs here
# GOOGLE_ANALYTICS_ID=
# FACEBOOK_PIXEL_ID=
