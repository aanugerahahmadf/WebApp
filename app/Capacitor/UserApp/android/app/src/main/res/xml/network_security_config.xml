<?xml version="1.0" encoding="utf-8"?>
<!--
    App Transport Security for the WebView that loads the Laravel panel.

    Production traffic stays https-only, so this file is safe to ship: point the
    app at your real domain with

        npm run set:url -- https://dekorasi.example.com/user

    and none of the cleartext exceptions below are used.

    Dev against a local backend, cleartext http is allowed only for these exact
    hosts:

        localhost   a server bound on the device / Genymotion
        10.0.2.2    Android emulator alias for the host machine  (most common)
        10.0.3.2    Genymotion alias for the host machine

    Testing on a PHYSICAL device? Android has no CIDR support here: `<domain>`
    must be a literal host. Add your machine's LAN address as its own entry,
    e.g. `<domain includeSubdomains="false">192.168.1.50</domain>`, and make
    sure `php artisan serve --host=0.0.0.0` binds to the network rather than
    127.0.0.1. A tunnel (ngrok / cloudflared) to an https URL is easier still,
    and needs no change here.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>

    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">localhost</domain>
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="false">10.0.2.2</domain>
        <domain includeSubdomains="false">10.0.3.2</domain>
        <!--
            Physical device on the same Wi-Fi: add your LAN address here, e.g.
            <domain includeSubdomains="false">192.168.1.50</domain>
        -->
    </domain-config>
</network-security-config>
