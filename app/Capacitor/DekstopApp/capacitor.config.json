{
  "appId": "id.dekorasi.pengantin.user",
  "appName": "Dekorasi User",
  "webDir": "dist",
  "server": {
    "url": "http://127.0.0.1:8000/home",
    "androidScheme": "http",
    "iosScheme": "http",
    "cleartext": true
  },
  "plugins": {
    "SplashScreen": {
      "launchAutoHide": true,
      "launchShowDuration": 0,
      "backgroundColor": "#eab308",
      "androidScaleType": "CENTER_CROP",
      "showSpinner": false,
      "splashFullScreen": true,
      "splashImmersive": false
    }
  }
}
