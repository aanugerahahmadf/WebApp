<?xml version='1.0' encoding='utf-8'?>
<resources>
    <!--
        app_name / title_activity_main track `appName` in capacitor.config.json.
        package_name / custom_url_scheme track `appId` and must stay in sync with
        the Android applicationId, which `npx cap sync` derives from appId.
    -->
    <string name="app_name">Dekorasi Admin</string>
    <string name="title_activity_main">Dekorasi Admin</string>
    <string name="package_name">id.dekorasi.pengantin.admin</string>
    <string name="custom_url_scheme">id.dekorasi.pengantin.admin</string>
</resources>
