<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="tests/bootstrap.php"
         colors="true"
>
    <testsuites>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <!--
            Integration: request HTTP sungguhan yang melewati seluruh middleware
            stack (auth, locale, panel, EnsureProfileComplete) lalu dicek efeknya
            ke database. Dipisah dari Feature karena Feature menguji satu
            komponen atau satu Livewire page, sedangkan di sini yang diuji adalah
            rangkaian middleware-nya, tempat bug produksi paling sering muncul
            karena urutan dan konfigurasi middleware tidak pernah diuji satu
            per satu.
        -->
        <testsuite name="Integration">
            <directory>tests/Integration</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>app</directory>
        </include>
    </source>
    <php>
        <ini name="memory_limit" value="512M"/>
        <env name="APP_ENV" value="testing"/>
        <!--
            APP_URL WAJIB dikunci di sini, bukan hanya karena isinya kebetulan cocok
            dengan .env lokal.

            Hampir semua route helper (`route()`, `Page::getUrl()`,
            `Panel::getLoginUrl()`) mengembalikan URL ABSOLUT, jadi nilainya ikut
            `APP_URL`. Tanpa kunci ini, assertion seperti

                ->assertSee(route('filament.user.pages.home'), escape: false)

            membandingkan tautan di HTML terhadap host yang tertulis di `.env`
            mesin itu. Di mesin dengan `APP_URL=https://produksi.domain`, test
            membandingkan `https://produksi.domain/user/home` dengan HTML yang
            dirender memakai host yang sama, jadi hijau. Di mesin lain nilainya
            berbeda dan test yang sama gagal. Hasilnya: test yang perilakunya
            tidak bermasalah, tapi kelulusannya bergantung pada file lokal yang
            tidak ikut di-commit.

            Mengunci ke `http://127.0.0.1:8000` membuat hasil test sama di
            mana saja, dan cocok dengan host yang dipakai request test.
        -->
        <env name="APP_URL" value="http://127.0.0.1:8000"/>
        <env name="APP_KEY" value="base64:qlfLQwBtJA/blNrn3/qZ8T3NZYaj9cSHCPI88Ldmelo="/>
        <env name="APP_MAINTENANCE_DRIVER" value="file"/>
        <env name="BCRYPT_ROUNDS" value="4"/>
        <env name="BROADCAST_CONNECTION" value="null"/>
        <env name="CACHE_STORE" value="array"/>
        <!--
            DB_DATABASE saja tidak cukup: config/database.php membaca
            DB_CONNECTION dari .env, dan .env produksi menunjuk MySQL. Akibatnya
            `php artisan test` secara lokal bisa menyasar database MySQL asli
            bernama "testing". Kunci keduanya di sini supaya hasil lokal sama
            dengan CI (ci.yml menyetel sqlite + :memory: di level job).
        -->
        <env name="DB_CONNECTION" value="sqlite"/>
        <env name="DB_DATABASE" value=":memory:"/>
        <env name="MAIL_MAILER" value="array"/>
        <env name="QUEUE_CONNECTION" value="sync"/>
        <env name="SESSION_DRIVER" value="array"/>
        <env name="PULSE_ENABLED" value="false"/>
        <env name="TELESCOPE_ENABLED" value="false"/>
        <env name="NIGHTWATCH_ENABLED" value="false"/>
    </php>
</phpunit>
