# Desktop Platform Environment Configuration
# 
# This file contains environment variables specific to the desktop platform
# (the Electron shell under app/Capacitor/{UserApp,AdminApp}/electron).
# 
# These values override the base .env file when running in desktop mode.
# Copy this file to .env.desktop and customize for your desktop app.
#
# IMPORTANT: Desktop has the SAME FEATURES as the website. The Electron shell
# is a packaged WebView around the same Laravel server, not different
# functionality.
#
# ── Multi-Port Development Strategy ──────────────────────────────────────────
# When running multiple platform modes simultaneously, each uses a distinct port:
#   Web    (php artisan serve:web)    → port 8000  (see .env.web.example)
#   Mobile (php artisan serve:mobile) → port 8001  (see .env.mobile.example)
#   Desktop(php artisan serve:desktop)→ port 8002  (this file)
#
# Start desktop mode:  php artisan serve:desktop --port=8002
# The Laravel server backing the desktop app will listen on port 8002.
#
# The shell loads that server over HTTP — there is no embedded PHP runtime, so
# this file is the only place the server's behaviour is configured. Everything
# about the window, packaging and updates (Electron version, window size,
# electron-builder targets, auto-update feed) lives in the shell's own
# `electron/` directory and its `capacitor.config.json`, not here.
# ─────────────────────────────────────────────────────────────────────────────

# Application URL for desktop platform
# The shell talks to a local server; port 8002 avoids conflicting with the web
# (8000) and mobile (8001) servers.
APP_URL=http://localhost:8002

# Must match the `server.url` in the shell's capacitor.config.json. This is a
# mirror for PHP-side helpers only — the app reads the shell's own file.
CAPACITOR_USER_URL=http://localhost:8002/user
CAPACITOR_ADMIN_URL=http://localhost:8002/admin

# Session driver for desktop platform
# File-based sessions work well for a single local user
SESSION_DRIVER=file

# Session lifetime (in minutes)
# Desktop sessions can be very long-lived since it's a local app
SESSION_LIFETIME=43200

# Cache driver for desktop platform
# File cache is ideal for desktop applications
CACHE_DRIVER=file

# Queue connection for desktop platform
# Sync is fine for desktop apps (single user, local execution)
QUEUE_CONNECTION=sync

# Broadcasting driver for desktop platform
# The shell is an ordinary browser context, so pusher/reach it the same way as
# the website. Leave `log` in development so broadcasts are inspectable.
BROADCAST_DRIVER=log

# Filesystem disk for desktop uploads
# Local disk; the shell has full filesystem access
FILESYSTEM_DISK=local

# VITE configuration for desktop platform
# Selects the public/build/desktop bundle at runtime
VITE_PLATFORM=desktop

# Desktop analytics
# The shell forwards these to the Sentry/Electron crash reporters, not to PHP.
# SENTRY_DSN=

# Note: the desktop app runs the same interface as a browser, so it supports
# the same features (WebRTC, etc.). The only difference is the delivery
# mechanism (Electron wrapper vs. browser).
